@@ -537,15 +537,35 @@ void rr_set_nsec(struct rr_entry *rr_nsec, enum rr_type type) {
   rr_nsec->data.NSEC.bitmap[type / 8] = 1 << (7 - (type % 8));
 }
 
+// like create_label(), but a TXT string may be up to 255 bytes rather than the
+// 63 bytes of a domain name label (AirPlay 2 records such as "pk=..." are longer)
+static uint8_t *create_txt_label(const char *txt) {
+  size_t len = strlen(txt);
+  if (len > 255)
+    return NULL;
+  uint8_t *s = malloc(len + 2);
+  if (s == NULL)
+    die("can not allocate memory for a TXT string in tinysvcmdns.");
+  s[0] = len;
+  memcpy((char *)s + 1, txt, len);
+  s[len + 1] = '\0';
+  return s;
+}
+
 void rr_add_txt(struct rr_entry *rr_txt, const char *txt) {
   struct rr_data_txt *txt_rec;
   assert(rr_txt->type == RR_TXT);
 
+  if (strlen(txt) > 255) {
+    warn("tinysvcmdns: TXT string longer than 255 bytes ignored: \"%s\".", txt);
+    return;
+  }
+
   txt_rec = &rr_txt->data.TXT;
 
   // is current data filled?
   if (txt_rec->txt == NULL) {
-    txt_rec->txt = create_label(txt);
+    txt_rec->txt = create_txt_label(txt);
     return;
   }
 
@@ -557,7 +577,7 @@ void rr_add_txt(struct rr_entry *rr_txt, const char *txt) {
   txt_rec->next = malloc(sizeof(struct rr_data_txt));
 
   txt_rec = txt_rec->next;
-  txt_rec->txt = create_label(txt);
+  txt_rec->txt = create_txt_label(txt);
   txt_rec->next = NULL;
 }
 
