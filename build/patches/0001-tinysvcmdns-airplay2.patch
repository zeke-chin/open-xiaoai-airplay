-      }
     }
   }
 
@@ -1704,6 +1735,9 @@ struct mdns_service *mdnsd_register_svc(struct mdnsd *svr, const char *instance_
 
   pthread_mutex_unlock(&svr->data_lock);
 
+  service->txt = txt_e;
+  service->ptr = ptr_e;
+
   // don't free type_nlabel - it's with the PTR record
   if (nlabel)
     free(nlabel);
@@ -1715,6 +1749,37 @@ struct mdns_service *mdnsd_register_svc(struct mdnsd *svr, const char *instance_
   return service;
 }
 
+void mdnsd_update_svc_txt(struct mdnsd *svr, struct mdns_service *srv, const char *txt[]) {
+  struct rr_entry *txt_e = srv->txt;
+  struct rr_data_txt *txt_rec, *next;
+
+  if (txt_e == NULL)
+    return;
+
+  pthread_mutex_lock(&svr->data_lock);
+
+  // free the existing TXT strings, keeping the node embedded in the entry
+  for (txt_rec = &txt_e->data.TXT; txt_rec; txt_rec = next) {
+    next = txt_rec->next;
+    if (txt_rec->txt)
+      free(txt_rec->txt);
+    if (txt_rec != &txt_e->data.TXT)
+      free(txt_rec);
+  }
+  txt_e->data.TXT.txt = NULL;
+  txt_e->data.TXT.next = NULL;
+
+  for (; txt && *txt; txt++)
+    rr_add_txt(txt_e, *txt);
+
+  // re-announce the service so that clients pick up the new TXT record
+  rr_list_append(&svr->announce, srv->ptr);
+
+  pthread_mutex_unlock(&svr->data_lock);
+
+  write_pipe(svr->notify_pipe[1], ".", 1);
+}
+
 void mdns_service_destroy(struct mdns_service *srv) {
   assert(srv != NULL);
   rr_list_destroy(srv->entries, 0);
@@ -1744,7 +1809,13 @@ struct mdnsd *mdnsd_start() {
     return NULL;
   }
 
-  pthread_mutex_init(&server->data_lock, NULL);
+  // recursive: the server loop holds data_lock while answering, and populate_answers()
+  // etc. take it again
+  pthread_mutexattr_t lock_attr;
+  pthread_mutexattr_init(&lock_attr);
+  pthread_mutexattr_settype(&lock_attr, PTHREAD_MUTEX_RECURSIVE);
+  pthread_mutex_init(&server->data_lock, &lock_attr);
+  pthread_mutexattr_destroy(&lock_attr);
 
   // init thread
   pthread_attr_init(&attr);
